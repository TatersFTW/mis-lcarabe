# =============================================================================
# FILE: .env.example
# -----------------------------------------------------------------------------
# PURPOSE:  Template for the project's environment configuration. Copy it to a
#           file named '.env' and edit the values. settings.py loads '.env' at
#           startup (see load_env_file in project/project/settings.py).
# USAGE:    copy .env.example .env      (then edit .env as needed)
# NOTE:     The DB_* values below describe MySQL, but settings.py currently
#           hard-codes SQLite, so changing DB_* alone will not switch databases.
# =============================================================================

# Django's secret signing key. CHANGE THIS to a long random value in production.
SECRET_KEY=change-this-secret-key

# 'True' shows detailed error pages (development). Use 'False' in production.
DEBUG=True

# Comma-separated list of allowed host/domain names this site may serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database connection settings -------------------------------------------
# Django database backend to use. Default here is the MySQL backend (XAMPP).
DB_ENGINE=django.db.backends.mysql
# Name of the database/schema to connect to.
DB_NAME=realestate_db
# Database user.
DB_USER=root
# Database password (left blank for a default XAMPP install).
DB_PASSWORD=
# Database host.
DB_HOST=localhost
# Database port (3306 is the default MySQL/MariaDB port).
DB_PORT=3306
